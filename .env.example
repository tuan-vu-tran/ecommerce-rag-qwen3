# ---------------------------------------------------------------------------
# Variables d'environnement du BACKEND (toutes optionnelles).
# Sans aucune de ces variables, le projet tourne avec les valeurs par défaut
# du lancement local. Les valeurs ci-dessous sont justement ces défauts.
# Copier en .env si besoin : cp .env.example .env
# ---------------------------------------------------------------------------

# URL du serveur Ollama.
#   - lancement local  : http://localhost:11434
#   - depuis un conteneur Docker (Ollama sur l'hôte) :
#       http://host.docker.internal:11434   (déjà défini dans docker-compose.yml)
OLLAMA_HOST=http://localhost:11434

# Dossier de la base ChromaDB persistante.
CHROMA_PATH=./chroma_db

# Fichier du catalogue produits.
CATALOGUE_PATH=./data/catalogue.json

# Origines autorisées par CORS, séparées par des virgules.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
